# ---------------------------------------------------------------------------
# Storage
# Local dev leaves this as SQLite. In production paste the Postgres URL your
# host gives you (Supabase/Neon both hand you one).
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./kaki.db

# ---------------------------------------------------------------------------
# Auth — generate your own before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-before-you-deploy-anything
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Telegram ingestion
# api_id / api_hash come from https://my.telegram.org -> API development tools.
# These sign in as YOUR account, which is the only way to read group history.
# ---------------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHAT=sg_badminton

# Optional but strongly recommended: watch only the "available games" topic.
# Find it with: python -m scripts.list_topics
TELEGRAM_TOPIC_ID=

TELEGRAM_SESSION_PATH=./data/kaki.session
BACKFILL_LIMIT=5000

# ---------------------------------------------------------------------------
# Web
# CORS_ORIGINS must list the exact origin your frontend is served from.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
